# quiby.core Backend Server Configuration
PORT=3001
HOST=0.0.0.0
JWT_SECRET=your-secure-jwt-secret-key-change-this
ADMIN_API_KEY=quiby-admin-secret-key-s6

# Discord OAuth2 App Credentials
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=

# Minecraft server address. Leave empty until the server exists.
MC_SERVER_IP=
MC_SERVER_PORT=25565

# Separate credential shared only by backend and the moderation bot (32+ chars).
# Empty = bot review API disabled. Never put this in VITE_* or the launcher.
MOD_REVIEW_BOT_API_KEY=
