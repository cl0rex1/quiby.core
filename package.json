{
  "name": "quiby-core-root",
  "version": "1.1.1",
  "private": true,
  "description": "quiby.core - Minecraft 1.21.1 NeoForge Launcher & Modpack Management Ecosystem for Season 6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "pack:import": "tsx scripts/import-modrinth.ts",
    "pack:server": "python scripts/build-server-pack.py",
    "pack:release": "node scripts/publish-github-release.mjs pack",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:launcher": "npm run dev --workspace=apps/launcher",
    "build:shared": "npm run build --workspace=packages/shared",
    "prebuild": "npm run build:shared",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build --workspace=apps/server",
    "build:launcher": "npm run build --workspace=apps/launcher",
    "build:pack-builder": "npm run build --workspace=packages/pack-builder",
    "pack:cli": "npm run cli --workspace=packages/pack-builder --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npx tsx --test apps/server/src/__tests__/*.test.ts apps/launcher/src/main/engine/__tests__/*.test.ts apps/launcher/src/renderer/src/utils/__tests__/*.test.ts apps/launcher/src/renderer/src/utils/chibiLive/__tests__/*.test.ts"
  },
  "keywords": [
    "minecraft",
    "neoforge",
    "launcher",
    "quiby",
    "create",
    "discord-auth",
    "modpack"
  ],
  "author": "quiby team",
  "license": "MIT"
}
