{
  "name": "@quiby/launcher",
  "version": "1.0.1-beta.19",
  "description": "quiby. Season 6 Minecraft 1.21.1 NeoForge Desktop Launcher",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "release:github": "npm run dist:win && node ../../scripts/publish-github-release.mjs launcher",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "fun.quiby.launcher",
    "productName": "quiby.core Тестовый",
    "artifactName": "quiby.core-Setup-${version}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "publish": {
      "provider": "github",
      "owner": "cl0rex1",
      "repo": "quiby-launcher-releases",
      "channel": "beta"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/renderer/src/assets/quiby_q_logo.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "src/renderer/src/assets/quiby_q_logo.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@quiby/shared": "*",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.8",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
