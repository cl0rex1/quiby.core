# Generate both secrets with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-another-random-secret-at-least-32-characters

# Same value must be configured in quiby.bot
MOD_REVIEW_BOT_API_KEY=replace-with-a-random-secret-at-least-32-characters

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Required for Discord OAuth login. Register the redirect URI in Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:45678/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=

MC_SERVER_IP=
MC_SERVER_PORT=25565

# API ↔ Minecraft chat bridge; 32+ characters, never expose in the launcher.
GAME_BRIDGE_API_KEY=

# Optional automatic game transport. Generate privately with deploy/direct/prepare_permanent.py.
DIRECT_SERVER=
DIRECT_PORT=443
DIRECT_CA=
DIRECT_PROVIDER_KEY=
