{
  "name": "@quiby/launcher",
  "version": "1.1.5",
  "description": "quiby. Season 6 Minecraft 1.21.1 NeoForge Desktop Launcher",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux dir --x64 --publish never -c.directories.output=release/linux && python ../../scripts/package-linux.py",
    "dist:arch": "npm run build && electron-builder --linux dir --x64 --publish never -c.directories.output=release/linux && python ../../scripts/package-arch.py",
    "release:github": "npm run dist:win && node ../../scripts/publish-github-release.mjs launcher",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:ui": "playwright test",
    "test:electron": "npm run build && electron tests/electron-smoke.cjs",
    "prepare:direct": "node ../../scripts/prepare-direct-runtime.cjs"
  },
  "build": {
    "appId": "fun.quiby.launcher",
    "npmRebuild": false,
    "productName": "quiby.core",
    "artifactName": "quiby.core-Setup-${version}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "publish": {
      "provider": "github",
      "owner": "cl0rex1",
      "repo": "quiby-launcher-releases",
      "channel": "latest"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/register-scheme/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/src/assets/quiby_q_logo.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "src/renderer/src/assets/quiby_q_logo.png",
      "target": "nsis",
      "extraResources": [
        {
          "from": "direct",
          "to": "direct"
        }
      ],
      "signExts": [
        "!frpc-0.71.1.exe"
      ]
    },
    "linux": {
      "executableName": "quiby-core",
      "category": "Game",
      "icon": "src/renderer/src/assets/quiby_q_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "beforePack": "../../scripts/prepare-direct-runtime.cjs",
    "afterPack": "../../scripts/verify-direct-runtime.cjs"
  },
  "dependencies": {
    "@quiby/shared": "*",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/discord-rpc": "^4.0.8",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
